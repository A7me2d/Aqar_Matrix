{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "schematics": { "@schematics/angular:component": { "style": "scss", "standalone": true, "skipTests": true } },
  "projects": {
    "aqar-matrix": {
      "projectType": "application", "root": "", "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/aqar-matrix", "index": "src/index.html",
            "browser": "src/main.ts", "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss", "styles": ["src/styles.scss"],
            "assets": [{ "glob": "**/*", "input": "public" }]
          },
          "configurations": {
            "production": { "outputHashing": "all", "budgets": [{ "type": "initial", "maximumWarning": "800kB", "maximumError": "1.5MB" }] },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "proxyConfig": "proxy.conf.cjs" },
          "configurations": {
            "development": { "buildTarget": "aqar-matrix:build:development" },
            "production": { "buildTarget": "aqar-matrix:build:production" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
